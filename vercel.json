{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npx --yes corepack@0.36.0 pnpm install --frozen-lockfile --filter @rps/web...",
  "buildCommand": "npx --yes corepack@0.36.0 pnpm --filter @rps/web build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://rps-commitments.onrender.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://rps-commitments.onrender.com/health"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
